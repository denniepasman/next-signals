{
  "name": "@dennieos/next-signals",
  "version": "1.0.0",
  "description": "Client error capture for DennieOS in Next.js apps (App Router, Next 14-15): onRequestError, browser errors, Vercel log drain and the signed intake contract v1.",
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": { "access": "restricted" },
  "type": "module",
  "engines": { "node": ">=18.18" },
  "files": ["dist", "sql", "README.md"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./instrumentation": { "types": "./dist/instrumentation.d.ts", "import": "./dist/instrumentation.js", "require": "./dist/instrumentation.cjs" },
    "./routes": { "types": "./dist/routes.d.ts", "import": "./dist/routes.js", "require": "./dist/routes.cjs" },
    "./client": { "types": "./dist/client.d.ts", "import": "./dist/client.js", "require": "./dist/client.cjs" },
    "./sql/001_dennieos_error_events.sql": "./sql/001_dennieos_error_events.sql",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": ">=14.0.0 <17.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
